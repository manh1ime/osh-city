# PostgreSQL
# Вариант 1: Postgres из docker-compose (порт хоста 5433, чтобы не мешать локальному PostgreSQL)
DATABASE_URL="postgresql://uchkuduk:uchkuduk@localhost:5433/uchkuduk?schema=public"
DIRECT_URL="postgresql://uchkuduk:uchkuduk@localhost:5433/uchkuduk?schema=public"
# Для Supabase: DATABASE_URL — Transaction pooler (:6543), DIRECT_URL — Direct/Session (:5432).
# Вариант 2: уже установленный на компьютере PostgreSQL:
# DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/uchkuduk?schema=public"
# DIRECT_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/uchkuduk?schema=public"

# Секрет для подписи сессионных cookie (обязательно поменять в продакшене)
AUTH_SECRET="change-me-please-32-chars-minimum-secret"

# Соль для хеширования IP / User-Agent гостей (персональные данные не хранятся в открытом виде)
HASH_SALT="change-me-hash-salt"

# Идентификатор ресторана и публичный адрес для генерации QR-ссылок
RESTAURANT_SLUG="uchkuduk"
NEXT_PUBLIC_APP_URL=https://uchkuduk.ru

# Пароль для демо-аккаунтов в seed
SEED_DEMO_PASSWORD="demo123"
