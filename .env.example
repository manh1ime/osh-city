# PostgreSQL
# Вариант 1: Postgres из docker-compose (порт хоста 5433, чтобы не мешать локальному PostgreSQL)
DATABASE_URL="postgresql://osh-city:osh-city@localhost:5433/osh-city?schema=public"
DIRECT_URL="postgresql://osh-city:osh-city@localhost:5433/osh-city?schema=public"
# Для Supabase: DATABASE_URL — Transaction pooler (:6543), DIRECT_URL — Direct/Session (:5432).
# Вариант 2: уже установленный на компьютере PostgreSQL:
# DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/osh-city?schema=public"
# DIRECT_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/osh-city?schema=public"

# Секрет для подписи сессионных cookie (обязательно поменять в продакшене)
AUTH_SECRET="change-me-please-32-chars-minimum-secret"

# Соль для хеширования IP / User-Agent гостей (персональные данные не хранятся в открытом виде)
HASH_SALT="change-me-hash-salt"

# Идентификатор ресторана и публичный адрес для генерации QR-ссылок
RESTAURANT_SLUG="osh-city"
NEXT_PUBLIC_APP_URL=https://osh-city.ru

# Пароль для демо-аккаунтов в seed
SEED_DEMO_PASSWORD="demo123"

# Web Push (VAPID): без этих ключей уведомления приходят только в открытую вкладку.
# Своя пара для продакшена:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Публичный ключ попадает в браузер, приватный держим только на сервере.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Контакт администратора: push-сервисы требуют его в заголовке запроса.
VAPID_SUBJECT="mailto:admin@osh-city.ru"
