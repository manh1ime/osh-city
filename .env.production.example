# Copy to .env.production on the VPS. Do not commit the copied file.
POSTGRES_USER=uchkuduk
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=uchkuduk
AUTH_SECRET=replace-with-at-least-32-random-characters
HASH_SALT=replace-with-a-different-random-salt
RESTAURANT_SLUG=uchkuduk
NEXT_PUBLIC_APP_URL=https://your-domain.ru
APP_PORT=3000

# Web Push: без этих ключей уведомления приходят только в открытую вкладку.
# Своя пара обязательна, ключи из репозитория использовать нельзя:
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.ru
